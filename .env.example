# WATCHKEEPER v2.0 Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# SECURITY (REQUIRED - CHANGE THESE!)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_key_minimum_32_characters_change_this_immediately

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_MASTER_KEY=your_encryption_master_key_minimum_32_characters_change_this

# JWT Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://watchkeeper_user:your_secure_db_password@postgres:5432/watchkeeper

# PostgreSQL Database (for Docker)
POSTGRES_USER=watchkeeper_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=watchkeeper

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# ELASTICSEARCH
# =============================================================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# EMAIL / SMTP (for alerts)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@watchkeeper.org
SMTP_PASSWORD=your_email_password
SMTP_FROM=alerts@watchkeeper.org

# =============================================================================
# SMS / TWILIO (for SMS alerts)
# =============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_PASSWORD=admin123

# Slack Webhooks
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty
PAGERDUTY_SERVICE_KEY=your_pagerduty_service_key

# =============================================================================
# EXTERNAL APIs (Optional)
# =============================================================================
OPENAI_API_KEY=sk-your_openai_api_key
MAPBOX_TOKEN=pk.your_mapbox_token
