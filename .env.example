# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/watchkeeper
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Ollama AI Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# API Settings
SECRET_KEY=your_secret_key_here
API_KEY_HEADER=X-API-Key
API_KEY=your_api_key_here

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Collection Settings
DEFAULT_COLLECTION_FREQUENCY=3600  # in seconds
MAX_RATE_LIMIT=100  # requests per hour

# Redis Configuration (for Celery & Caching)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=watchkeeper@example.com
SMTP_USE_TLS=true

# Twilio SMS Settings (optional)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Alert Settings
ALERT_EMAIL_RECIPIENTS=["admin@example.com"]
ALERT_SMS_RECIPIENTS=["+1234567890"]
ALERT_WEBHOOK_URLS=["https://your-webhook.com/alerts"]
HIGH_THREAT_THRESHOLD=8.0
CRITICAL_THREAT_THRESHOLD=9.0

# Elasticsearch (for advanced search)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=watchkeeper

# Monitoring & Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Job Scheduler
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=UTC

# Export Settings
EXPORT_DIR=/tmp/watchkeeper_exports
MAX_EXPORT_SIZE_MB=100

# Audit Logging
ENABLE_AUDIT_LOG=true
AUDIT_LOG_RETENTION_DAYS=90
