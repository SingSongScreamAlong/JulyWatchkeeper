# Configure logging
logging_dir = Path('data/logs')
logging_dir.mkdir(parents=True, exist_ok=True)

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.StreamHandler(),
        logging.FileHandler(logging_dir / 'watchkeeper.log', mode='a')
    ]
)
